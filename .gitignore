# ===========================
# Python関連ファイル（中間ファイルのみ除外）
# ===========================
__pycache__/                # Pythonが生成するキャッシュディレクトリ
*.py[cod]                   # .pyc: バイトコード, .pyo: 最適化コード, .pyd: C拡張（Windows）
                            # → .py（コード本体）は除外されません！Gitで管理されます
*.so                        # C拡張モジュールなどのバイナリ（Linux系）
*.log                       # ログファイル
*.sqlite3                   # SQLiteデータベース（開発中に使う場合）
*.env                       # 環境変数ファイル（APIキーやトークンを含む可能性あり）
*.egg-info/                 # Pythonパッケージビルド時に生成されるファイル

# ===========================
# Jupyter Notebook関連
# ===========================
.ipynb_checkpoints/         # Jupyterの一時保存フォルダ
*.nbconvert.ipynb           # nbconvertなどで生成される変換ファイル

# ===========================
# IDEやエディタの設定ファイル（個人環境依存）
# ===========================
.vscode/                    # Visual Studio Codeの設定
.idea/                      # JetBrains製IDE（PyCharmなど）の設定

# ===========================
# OSごとの不要ファイル
# ===========================
.DS_Store                   # macOSのフォルダ情報ファイル
Thumbs.db                   # Windowsの画像キャッシュファイル

# ===========================
# データ関連（サイズ大・著作権リスクあり）
# ===========================
data/                       # 生データや外部データなど（raw/, processed/ などすべて含む）
!data/README.md             # 空フォルダ保持用のREADMEは例外として追跡

# ===========================
# 実験ログ・モデル・評価結果など（都度生成される）
# ===========================
experiments/                # 実験結果（logs, results, models）
!experiments/README.md      # 説明用READMEだけ追跡

outputs/                    # モデル予測結果や可視化画像
!outputs/README.md          # 説明用READMEだけ追跡

# ===========================
# 学習済みモデルファイル（重く、再生成可能）
# ===========================
*.pkl                       # Pythonのpickle形式
*.h5                        # HDF5形式（Kerasなど）
*.pt                        # PyTorchモデル
*.ckpt                      # Checkpointファイル
*.joblib                    # joblibによる保存ファイル
*.model                     # 独自拡張子
*.sav                       # Scikit-learnなどの保存形式
*.npz                       # numpy圧縮形式
*.npy                       # numpy配列データ

# ===========================
# その他（必要に応じて追加）
# ===========================
# requirements.lock         # ライブラリバージョン固定ファイル（不要なら除外）
# secrets.json              # APIキーなどの秘匿情報を含むファイル
